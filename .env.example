# Database — PostgreSQL via Supabase (or Neon, AWS RDS, Railway)
# DATABASE_URL = pooled connection (used by the app at runtime)
# DIRECT_URL   = direct connection (used by Prisma for migrations)
# Required for admin panel & CMS. Site renders without it via hardcoded defaults.
DATABASE_URL="postgresql://postgres.project_ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&connect_timeout=30"
DIRECT_URL="postgresql://postgres.project_ref:password@region.pooler.supabase.com:5432/postgres"

# Admin credentials — used for /admin login
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="<generate-with: openssl rand -base64 24>"
ADMIN_SESSION_SECRET="<generate-with: openssl rand -base64 32>"
ADMIN_RECOVERY_CODE="<generate-with: openssl rand -base64 16>"

# S3-compatible media upload config
# Use Cloudflare R2, AWS S3, or DigitalOcean Spaces in production
S3_BUCKET_NAME="agency-media"
S3_REGION="us-east-1"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_PUBLIC_BASE_URL="https://pub-<hash>.r2.dev/agency-media"
S3_UPLOAD_PREFIX="media"

# SMTP (used by contact form — Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
